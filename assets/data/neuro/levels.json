  "brainLevels": [
    {
      "id": "med-caudal",
      "name": "延髓尾端（錐體交叉）",
      "en": "Caudal medulla – motor decussation",
      "y": 3,
      "desc": "延髓與脊髓交界。約 85–90% 的皮質脊髓纖維在這裡交叉到對側，成為外側皮質脊髓徑；薄束與楔束還在背側，三叉神經脊束核（尾側部）在外側。"
    },
    {
      "id": "med-sensory",
      "name": "延髓下段（感覺交叉）",
      "en": "Medulla – sensory decussation",
      "y": 9,
      "desc": "薄束核與楔束核發出內弓狀纖維，在中線交叉（感覺交叉），到對側組成內側蹄系。中央管仍是閉合的（closed medulla）。"
    },
    {
      "id": "med-olive",
      "name": "延髓中段（舌下神經核、疑核）",
      "en": "Mid medulla – inferior olive, hypoglossal nucleus",
      "y": 16,
      "desc": "第四腦室底由內到外是舌下神經核、迷走神經背核、孤束核、前庭核；疑核在被蓋腹外側。舌下神經從錐體與橄欖之間出去，迷走神經從橄欖後溝出去。內側蹄系在中線旁直立，前外側系統在外側。"
    },
    {
      "id": "med-rostral",
      "name": "延髓上段（舌咽神經、耳蝸神經核）",
      "en": "Rostral medulla – glossopharyngeal level",
      "y": 27,
      "desc": "舌咽神經從橄欖後溝出去；耳蝸神經核貼在下小腦腳外側，前庭神經核佔第四腦室底外側大部分。"
    },
    {
      "id": "pons-caudal",
      "name": "橋腦下段（顏面丘）",
      "en": "Caudal pons – facial colliculus",
      "y": 35,
      "desc": "第四腦室底的顏面丘：顏面神經的內膝繞過外旋神經核。顏面神經核在被蓋腹外側；外旋神經往腹側穿過基底部，在橋腦延髓交界靠中線出去。"
    },
    {
      "id": "pons",
      "name": "橋腦中段（三叉神經）",
      "en": "Mid pons – trigeminal level",
      "y": 47,
      "desc": "三叉神經從外側出入；運動核在內、主感覺核在外。皮質脊髓纖維在基底部被打散成小束；內側蹄系轉成被蓋腹側的橫帶，前外側系統在它外側。"
    },
    {
      "id": "midbrain-ic",
      "name": "中腦下段（下丘、滑車神經核）",
      "en": "Caudal midbrain – inferior colliculus",
      "y": 63,
      "desc": "滑車神經核在 MLF 背側，纖維繞過導水管周圍灰質往背側走，在上髓帆交叉後從對側下丘下方出去。上小腦腳在這一層交叉。"
    },
    {
      "id": "midbrain",
      "name": "中腦上段（上丘、動眼神經核、紅核）",
      "en": "Rostral midbrain – superior colliculus",
      "y": 71,
      "desc": "動眼神經核與 Edinger-Westphal 核在導水管腹側；動眼神經纖維往腹側穿過紅核，從大腦腳間窩出去。皮質脊髓纖維位在大腦腳中間約 1/3；紅核脊髓徑在腹側被蓋交叉、頂蓋脊髓徑在背側被蓋交叉。"
    },
    {
      "id": "dienc-caudal",
      "name": "間腦下段（乳頭體、膝狀體）",
      "en": "Caudal diencephalon – mamillary bodies",
      "y": 81,
      "desc": "中腦與間腦交界。中線兩旁是乳頭體；外側膝狀體與內側膝狀體貼在視丘後下方；視丘下核夾在內囊與紅核之間。"
    },
    {
      "id": "thalamus",
      "name": "視丘中段（VPL、VPM、VL）",
      "en": "Thalamus – ventral posterior nuclei",
      "y": 88.5,
      "desc": "內側蹄系與前外側系統止於對側 VPL（下肢在外、上肢在內）；三叉丘腦徑止於 VPM（臉）；VL 接收小腦與蒼白球。內髓板把背內側核與外側的核分開，中央中核埋在內髓板裡。外側是內囊後肢與豆狀核。"
    },
    {
      "id": "basal-ganglia",
      "name": "基底核（尾狀核頭、豆狀核）",
      "en": "Basal ganglia – horizontal section",
      "y": 93.5,
      "desc": "尾狀核頭突入側腦室前角；豆狀核分成外側的殼核與內側的蒼白球外節、內節；內囊前肢在尾狀核頭與豆狀核之間、後肢在視丘與豆狀核之間；殼核外側是外囊、屏狀核與島葉（Barr p.203）。"
    },
    {
      "id": "internal-capsule",
      "name": "內囊（前肢、膝部、後肢）",
      "en": "Internal capsule – horizontal section",
      "y": 96,
      "desc": "經典的水平切面：內囊前肢夾在尾狀核頭與豆狀核之間，膝部在視丘前核外側，後肢夾在視丘與豆狀核之間，後豆狀部在豆狀核後方。皮質延髓纖維在膝部、皮質脊髓纖維在後肢後半、體感覺放射在後肢最後段（Barr p.253–255）。"
    },
    {
      "id": "cortex",
      "name": "大腦皮質（中央前、後回）",
      "en": "Cerebral cortex – pre/postcentral gyri",
      "y": 165,
      "desc": "中央前回（初級運動皮質，area 4）與中央後回（初級體感覺皮質，areas 3, 1, 2）。下肢在內側面，上肢與臉往外側。"
    }
  ],
